---
layout: base.njk
---
<article class="post-full">
    <div class="container">
        <a href="/blog/" class="read-more back-link">&larr; Back to The Work</a>
        <header class="post-header">
            <h1 class="post-title">{{ title }}</h1>
            <time datetime="{{ date | htmlDateString }}" class="post-date">{{ date | readableDate }}</time>
        </header>
        <div class="post-body">
            {{ content | safe }}
        </div>
        <a href="/blog/" class="read-more">&larr; Back to The Work</a>
    </div>
</article>
