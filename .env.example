# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (Dashboard > Settings > API)
PRINTFUL_API_KEY=...

# Printful sync variant IDs for each product - find these by calling
# GET https://api.printful.com/store/products/{id} and using each
# sync_variant's numeric "id" field (NOT the "external_id" shown in the
# dashboard UI, and not the catalog "variant_id").
# Any product missing its variant ID here will be skipped during fulfillment
# (logged, not silently dropped) instead of sending bad data to Printful.
PRINTFUL_VARIANT_CROP_HOODIE=

# Public URL of the deployed site, used to build Stripe success/cancel URLs
CLIENT_URL=http://localhost:3000

# GitHub OAuth App (github.com/settings/developers) used to let the /admin
# CMS commit content back to this repo. Authorization callback URL must be
# exactly "<CLIENT_URL>/api/callback".
GITHUB_OAUTH_CLIENT_ID=...
GITHUB_OAUTH_CLIENT_SECRET=...
