# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (Dashboard > Settings > API)
PRINTFUL_API_KEY=...

# Printful variant IDs for each product - find these under
# Printful Dashboard > Store > Products > (select product) > Variants.
# Any product missing its variant ID here will be skipped during fulfillment
# (logged, not silently dropped) instead of sending bad data to Printful.
PRINTFUL_VARIANT_BEFORE_YOU_SPIRAL=
PRINTFUL_VARIANT_FAWN_KIT=
PRINTFUL_VARIANT_NERVOUS_SYSTEM=
PRINTFUL_VARIANT_BOUNDARY_RESET=

# Public URL of the deployed site, used to build Stripe success/cancel URLs
CLIENT_URL=http://localhost:3000
